      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "percentunit",
      "legendPosition": "bottom",
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "thresholds": [],
      "contextLinks": { "linksData": [] },
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "traces",
              "stepInterval": 60,
              "disabled": true,
              "aggregations": [{ "expression": "count()" }],
              "filter": {
                "expression": "service.name in $service_name AND traceforge.run.id in $run_id AND traceforge.phase in $phase AND has_error = true"
              },
              "groupBy": [
                {
                  "key": "traceforge.phase",
                  "dataType": "string",
                  "type": "tag",
                  "fieldContext": "attribute",
                  "fieldDataType": "string"
                }
              ],
              "legend": "errors {{traceforge.phase}}",
              "orderBy": [{ "columnName": "count()", "order": "desc" }],
              "selectColumns": [],
              "functions": [],
              "having": [],
              "limit": 10000
            },
            {
              "queryName": "B",
              "expression": "B",
              "dataSource": "traces",
              "stepInterval": 60,
              "disabled": true,
              "aggregations": [{ "expression": "count()" }],
              "filter": {
                "expression": "service.name in $service_name AND traceforge.run.id in $run_id AND traceforge.phase in $phase AND has_error = false"
              },
              "groupBy": [
                {
                  "key": "traceforge.phase",
                  "dataType": "string",
                  "type": "tag",
                  "fieldContext": "attribute",
                  "fieldDataType": "string"
                }
              ],
              "legend": "ok {{traceforge.phase}}",
              "orderBy": [{ "columnName": "count()", "order": "desc" }],
              "selectColumns": [],
              "functions": [],
              "having": [],
              "limit": 10000
            }
          ],
          "queryFormulas": [
            {
              "queryName": "F1",
              "expression": "A / (A + B)",
              "legend": "error rate {{traceforge.phase}}",
              "orderBy": [{ "columnName": "__result", "order": "desc" }],
              "having": [],
              "limit": 100,
              "disabled": false
            }
          ]
        }
      }
    },
