{
  "title": "TraceForge — Release Proof",
  "description": "Server-side proof for a TraceForge pre-production run. Select a run_id to compare the baseline, candidate, and patched phases of one experiment, then inspect the correlated spans and logs that justify the verdict. The last rows show TraceForge observing its own orchestration: state-machine stage durations and SigNoz MCP tool calls. Every panel is derived from traces and logs carrying the traceforge.run.id attribute; no metric series are used because the demo target's custom metrics are not queryable through MCP for these windows.",
  "tags": ["traceforge", "release-proof", "preproduction", "regression"],
  "variables": {
    "run_id": {
      "name": "run_id",
      "description": "TraceForge run under review. ALL means no run filter.",
      "type": "DYNAMIC",
      "dynamicVariablesAttribute": "traceforge.run.id",
      "dynamicVariablesSource": "All telemetry",
      "multiSelect": false,
      "showALLOption": true,
      "sort": "DISABLED",
      "order": 0
    },
    "phase": {
      "name": "phase",
      "description": "Experiment phase: baseline, candidate, or patched.",
      "type": "DYNAMIC",
      "dynamicVariablesAttribute": "traceforge.phase",
      "dynamicVariablesSource": "All telemetry",
      "multiSelect": true,
      "showALLOption": true,
      "sort": "ASC",
      "order": 1
    },
    "service_name": {
      "name": "service_name",
      "description": "Instrumented service under load; TraceForge's demo target is traceforge-demo-target.",
      "type": "DYNAMIC",
      "dynamicVariablesAttribute": "service.name",
      "dynamicVariablesSource": "All telemetry",
      "multiSelect": true,
      "showALLOption": true,
      "sort": "ASC",
      "order": 2
    }
  },
  "layout": [
    { "i": "tf-total-requests", "x": 0, "y": 0, "w": 3, "h": 3, "minW": 2, "minH": 2 },
    { "i": "tf-error-spans", "x": 3, "y": 0, "w": 3, "h": 3, "minW": 2, "minH": 2 },
    { "i": "tf-lock-logs", "x": 6, "y": 0, "w": 3, "h": 3, "minW": 2, "minH": 2 },
    { "i": "tf-span-p95", "x": 9, "y": 0, "w": 3, "h": 3, "minW": 2, "minH": 2 },
    { "i": "tf-requests-by-phase", "x": 0, "y": 3, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-error-rate-by-phase", "x": 6, "y": 3, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-latency-percentiles", "x": 0, "y": 10, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-status-distribution", "x": 6, "y": 10, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-lock-logs-by-phase", "x": 0, "y": 17, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-slow-operations", "x": 6, "y": 17, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-recent-traces", "x": 0, "y": 24, "w": 6, "h": 8, "minW": 4, "minH": 5 },
    { "i": "tf-recent-logs", "x": 6, "y": 24, "w": 6, "h": 8, "minW": 4, "minH": 5 },
    { "i": "tf-orchestrator-stages", "x": 0, "y": 32, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-mcp-tool-calls", "x": 6, "y": 32, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-mcp-tool-failures", "x": 0, "y": 39, "w": 6, "h": 7, "minW": 4, "minH": 5 },
    { "i": "tf-stage-failures", "x": 6, "y": 39, "w": 6, "h": 7, "minW": 4, "minH": 5 }
  ],
  "widgets": [
    {
      "id": "tf-total-requests",
      "title": "Requests observed server-side",
      "description": "Span count for the selected run, phase, and service.",
      "panelTypes": "value",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "none",
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "thresholds": [],
      "contextLinks": { "linksData": [] },
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryFormulas": [],
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "traces",
              "stepInterval": 60,
              "aggregations": [{ "expression": "count()" }],
              "filter": {
                "expression": "service.name in $service_name AND traceforge.run.id in $run_id AND traceforge.phase in $phase"
              },
              "groupBy": [],
              "orderBy": [{ "columnName": "count()", "order": "desc" }],
              "selectColumns": [],
              "functions": [],
              "having": [],
              "reduceTo": "sum",
              "limit": 100,
              "disabled": false
            }
          ]
        }
      }
    },
