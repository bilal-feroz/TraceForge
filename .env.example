# TraceForge runtime
TRACEFORGE_DATA_DIR=.traceforge
TRACEFORGE_ALLOWED_REPO_ROOTS=
TRACEFORGE_ALLOWED_TARGETS=127.0.0.1,localhost
TRACEFORGE_TRUSTED_LOCAL_MODE=false
TRACEFORGE_API_URL=http://127.0.0.1:8787
TRACEFORGE_WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_TRACEFORGE_API_URL=http://127.0.0.1:8787

# SigNoz Cloud telemetry ingestion (not the MCP API key)
SIGNOZ_REGION=
SIGNOZ_INGESTION_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<ingestion-key>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Only needed by the optional Docker Compose collector profile.
SIGNOZ_OTLP_BASE_ENDPOINT=https://ingest.<region>.signoz.cloud:443

# SigNoz control plane / MCP (not the ingestion key)
SIGNOZ_INSTANCE_URL=https://<instance>.signoz.cloud
SIGNOZ_API_KEY=
SIGNOZ_MCP_URL=https://mcp.<region>.signoz.cloud/mcp

# OpenTelemetry resource defaults
OTEL_SERVICE_NAME=traceforge-orchestrator
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=preproduction

# Optional LLM integration. TraceForge works deterministically without these.
TRACEFORGE_MODEL_PROVIDER=
TRACEFORGE_MODEL_NAME=
OPENAI_API_KEY=

