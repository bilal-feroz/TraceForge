{
  "name": "@traceforge/demo-video",
  "version": "1.0.0",
  "description": "TraceForge Remotion demo video",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/tailwind-v4": "4.0.499",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.499",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.499",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio --no-open",
    "dev": "remotion studio --no-open",
    "lint": "eslint src && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle",
    "render": "remotion render TraceForgeDemo ../out/traceforge-demo-youtube.mp4 --codec=h264",
    "render:draft": "remotion render TraceForgeDemo ../out/traceforge-demo-draft.mp4 --codec=h264 --scale=0.5",
    "render:thumbnail": "remotion still TraceForgeThumbnail ../out/traceforge-youtube-thumbnail.png",
    "upgrade": "remotion upgrade"
  },
  "sideEffects": [
    "*.css"
  ]
}
